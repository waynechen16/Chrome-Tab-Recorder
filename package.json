{
  "name": "chrome-tab-recorder",
  "version": "0.5.0",
  "description": "Record a Chrome tab's video and audio (e.g. Google Meet classes) to WebM.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  }
}
